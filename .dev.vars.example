# Copie este arquivo para ".dev.vars" e preencha com os seus valores.
# O ".dev.vars" está no .gitignore e nunca deve ir para o Git.

# Developer Portal > sua aplicação > General Information > Public Key
DISCORD_PUBLIC_KEY=""

# Developer Portal > General Information > Application ID
DISCORD_APPLICATION_ID=""

# Developer Portal > Bot > Reset Token
# Usado SÓ pelo script de registro (npm run register). O Worker não recebe este
# valor: o wrangler.jsonc lista em "secrets.required" apenas os segredos dele.
DISCORD_TOKEN=""

# Seu ID de usuário do Discord (Modo Desenvolvedor > clique direito no seu nome > Copiar ID)
OWNER_ID=""

# ID do seu servidor de testes (comandos de servidor atualizam na hora)
DISCORD_GUILD_ID=""

# FASE 3: webhook do canal privado #kaiky (Editar canal > Integrações > Webhooks > Copiar URL)
# É um segredo: quem tiver esta URL consegue postar no canal.
DISCORD_WEBHOOK_URL=""

# FASE 4: token fine-grained do GitHub, SOMENTE LEITURA (Metadata: Read + Issues: Read)
GITHUB_TOKEN=""

# Opcional: webhook do canal #dashboard (pendências atualizadas a cada 5 minutos)
DISCORD_DASHBOARD_WEBHOOK_URL=""
