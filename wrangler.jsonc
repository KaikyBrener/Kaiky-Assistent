// Configuração do Worker lida pelo Wrangler (dev local e deploy).
// Comentários são permitidos porque o formato é JSONC.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaiky-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // Publica em https://kaiky-assistant.<seu-subdominio>.workers.dev
  // Nenhuma rota de domínio próprio é configurada: o DNS não é tocado.
  "workers_dev": true,
  "preview_urls": false,

  // Variáveis NÃO secretas. Segredos (token, chave pública, IDs) ficam
  // em .dev.vars (local) e em `wrangler secret put` (produção).
  "vars": {
    "APP_NAME": "Kaiky Assistant"
  },

  // Segredos que o Worker PRECISA ter. Com esta lista:
  //  - `wrangler deploy` falha com erro claro se algum não estiver configurado;
  //  - `wrangler dev` carrega do .dev.vars SÓ estes nomes (o DISCORD_TOKEN,
  //    usado apenas pelo script de registro, não entra no Worker local).
  "secrets": {
    "required": ["DISCORD_PUBLIC_KEY", "OWNER_ID"]
  },

  // Logs e traces no painel da Cloudflare. Plano gratuito: 0,5 GB/dia de
  // ingestão (logs + traces juntos), 7 dias de retenção, sem cobrança extra.
  // `enabled` sozinho liga só os logs; traces precisam ser ligados à parte.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },

  // Banco de dados D1 (SQLite). No código ele aparece como `env.DB`.
  // O `database_id` NÃO é segredo: ele só diz qual banco usar, e sem o
  // token da sua conta ninguém acessa o banco por ele.
  // Banco criado com `npx wrangler d1 create kaiky-assistant-db` (ver README).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kaiky-assistant-db",
      "database_id": "8cfeb3a8-3311-4597-972e-9c533175f0a0",
      "migrations_dir": "migrations"
    }
  ]

  // FASE 3: aqui entrarão os Cron Triggers ("triggers": { "crons": [...] }).
}
